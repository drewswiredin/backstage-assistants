{
  "name": "backstage-assistants",
  "version": "0.0.0",
  "private": true,
  "description": "AI Assistants for Backstage.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drewswiredin/backstage-assistants.git"
  },
  "engines": {
    "node": "22 || 24"
  },
  "scripts": {
    "start": "dotenv -e .env -- backstage-cli repo start",
    "build:backend": "yarn workspace backend build",
    "build:all": "backstage-cli repo build --all",
    "build-image": "yarn workspace backend build-image",
    "tsc": "tsc",
    "tsc:full": "tsc --skipLibCheck false --incremental false",
    "clean": "backstage-cli repo clean",
    "test": "backstage-cli repo test",
    "test:e2e": "playwright test",
    "fix": "backstage-cli repo fix",
    "lint": "backstage-cli repo lint --since origin/master",
    "lint:all": "backstage-cli repo lint",
    "prettier:check": "prettier --check .",
    "build:api-reports": "backstage-repo-tools api-reports --allow-all-warnings"
  },
  "backstage": {
    "cli": {
      "new": {
        "globals": {
          "license": "Apache-2.0"
        }
      }
    }
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@backstage/cli": "^0.36.4",
    "@backstage/cli-defaults": "^0.1.4",
    "@backstage/e2e-test-utils": "^0.1.2",
    "@backstage/repo-tools": "^0.18.0",
    "@jest/environment-jsdom-abstract": "~30.2.0",
    "@playwright/test": "^1.32.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^18.0.0",
    "@types/react": "^18.0.0",
    "dotenv-cli": "^7.4.4",
    "jest": "~30.2.0",
    "jsdom": "^27.1.0",
    "node-gyp": "^10.0.0",
    "prettier": "^2.3.2",
    "typescript": "~5.8.0"
  },
  "resolutions": {
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@assistant-ui/core@npm:^0.3.0": "patch:@assistant-ui/core@npm%3A0.3.1#~/.yarn/patches/@assistant-ui-core-npm-0.3.1-6d6da84d75.patch",
    "@assistant-ui/core@npm:^0.3.1": "patch:@assistant-ui/core@npm%3A0.3.1#~/.yarn/patches/@assistant-ui-core-npm-0.3.1-6d6da84d75.patch"
  },
  "prettier": "@backstage/cli/config/prettier",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.4.1"
}
