{
  "name": "@drewswiredin/backstage-plugin-assistants-common",
  "version": "0.9.0",
  "description": "Shared browser-safe types — AI Assistants for Backstage.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "backstage": {
    "role": "common-library"
  },
  "sideEffects": false,
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "package.json": [
        "package.json"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/plugin-permission-common": "^0.9.9"
  },
  "keywords": [
    "backstage",
    "backstage-plugin",
    "ai",
    "assistant",
    "types"
  ],
  "author": "drewswiredin",
  "repository": {
    "type": "git",
    "url": "https://github.com/drewswiredin/backstage-assistants.git",
    "directory": "packages/assistants-common"
  },
  "homepage": "https://github.com/drewswiredin/backstage-assistants#readme",
  "bugs": "https://github.com/drewswiredin/backstage-assistants/issues",
  "devDependencies": {
    "@backstage/cli": "^0.36.4"
  }
}
