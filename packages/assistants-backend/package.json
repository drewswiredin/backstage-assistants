{
  "name": "@drewswiredin/backstage-plugin-assistants-backend",
  "version": "0.1.0",
  "description": "Backend plugin — AI Assistants for Backstage.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "assistants",
    "pluginPackages": [
      "@drewswiredin/backstage-plugin-assistants",
      "@drewswiredin/backstage-plugin-assistants-backend",
      "@drewswiredin/backstage-plugin-assistants-common"
    ]
  },
  "sideEffects": false,
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "package.json": [
        "package.json"
      ]
    }
  },
  "files": [
    "dist",
    "config.d.ts"
  ],
  "configSchema": "config.d.ts",
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack",
    "generate": "backstage-repo-tools package schema openapi generate --server"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.81",
    "@ai-sdk/azure": "^3.0.68",
    "@ai-sdk/openai": "^3.0.67",
    "@backstage/backend-defaults": "^0.17.2",
    "@backstage/backend-openapi-utils": "^0.6.9",
    "@backstage/backend-plugin-api": "^1.4.0",
    "@backstage/config": "^1.3.8",
    "@backstage/errors": "^1.3.1",
    "@backstage/plugin-search-common": "^1.2.24",
    "@backstage/types": "^1.2.2",
    "@drewswiredin/backstage-plugin-assistants-common": "0.1.0",
    "ai": "^6.0.193",
    "express": "^4.21.2",
    "node-html-parser": "^7.1.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@backstage/cli": "0.36.2",
    "@types/express": "^4.17.23",
    "@types/turndown": "^5.0.6"
  }
}
