{
  "name": "@drewswiredin/backstage-plugin-assistants-backend",
  "version": "0.1.0",
  "description": "Backend plugin \u2014 AI Assistants for Backstage.",
  "license": "Apache-2.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "assistants",
    "pluginPackages": [
      "@drewswiredin/backstage-plugin-assistants",
      "@drewswiredin/backstage-plugin-assistants-backend",
      "@drewswiredin/backstage-plugin-assistants-common"
    ]
  },
  "sideEffects": false,
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "package.json": [
        "package.json"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/backend-plugin-api": "^1.4.0",
    "@drewswiredin/backstage-plugin-assistants-common": "0.1.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@backstage/cli": "0.36.2",
    "@types/express": "^4.17.23"
  }
}
